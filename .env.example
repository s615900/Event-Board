# 設定範本：複製成 .env.local 後填入實際值（.env.local 不會上傳到 GitHub）

# MongoDB（賽事看板專用，不可與 qsprint 共用）
MONGODB_URI=mongodb+srv://帳號:密碼@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB=sports_board

# 登入用的密鑰：一串隨機文字即可（可用指令 openssl rand -hex 32 產生）
SESSION_SECRET=

# Google 登入（部署上線時才需要）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 選填：Google 登入完成後要回到的網址，例 https://你的網域/api/auth/google/callback
# 留空會自動使用目前網站的網址
GOOGLE_REDIRECT_URI=

# 本機測試用：設為 1 可不經過 Google，直接用名冊中的 Email 登入（正式網站不要設）
AUTH_TEST_MODE=
