# 複製成 .env.local 並填入實際值（.env.local 不會進 git）

# 簽章登入 cookie 用的密鑰（隨機長字串）
SESSION_SECRET=

# Ragic
RAGIC_API_KEY=
RAGIC_EVENTS_URL=
RAGIC_SPORTS_URL=
RAGIC_SOURCES_URL=
RAGIC_MEMBERS_URL=
RAGIC_CHANGELOG_URL=
RAGIC_REPORTS_URL=
RAGIC_SETTINGS_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 必須和 Google Cloud Console 註冊的 redirect URI 完全一致；留空則用目前網址自動推算
# 例：https://your-domain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# 設為 1 會開放 /api/auth/test-login（輸入名冊中的 Email 即可登入）— 正式環境絕對不要開
AUTH_TEST_MODE=
